{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"noEmit": true,
		"lib": ["ES2022", "WebWorker"],
		"types": ["node"]
	},
	"include": ["src/**/*", "test/**/*", "tsup.config.ts", "vitest.config.ts"],
	// The browser and React code need the DOM types, which clash with the
	// Workers ones, so tsconfig.react.json checks them.
	"exclude": [
		"src/browser.ts",
		"src/react.tsx",
		"test/browser.test.ts",
		"test/react.test.tsx",
		"test/fake-turnstile.ts"
	]
}
