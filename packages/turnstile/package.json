{
	"name": "@ai-food-focus/turnstile",
	"version": "0.1.0",
	"description": "Cloudflare Turnstile, done once: a server check for Workers and Node, a script loader for the browser, and a React hook and widget.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ai-food-focus/feedbakkr-core.git",
		"directory": "packages/turnstile"
	},
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./server": {
			"types": "./dist/server.d.ts",
			"import": "./dist/server.js"
		},
		"./browser": {
			"types": "./dist/browser.d.ts",
			"import": "./dist/browser.js"
		},
		"./react": {
			"types": "./dist/react.d.ts",
			"import": "./dist/react.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"build": "tsup",
		"typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.react.json",
		"test": "vitest run",
		"check:package": "publint --strict && attw --pack . --profile esm-only"
	},
	"peerDependencies": {
		"react": "^19.0.0"
	},
	"peerDependenciesMeta": {
		"react": {
			"optional": true
		}
	},
	"devDependencies": {
		"@arethetypeswrong/cli": "^0.18.5",
		"@testing-library/react": "^16.3.3",
		"@types/node": "^22.0.0",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"jsdom": "^30.1.2",
		"publint": "^0.3.25",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"tsup": "^8.5.1",
		"typescript": "~6.0.3",
		"vitest": "^4.1.11"
	},
	"publishConfig": {
		"registry": "https://npm.pkg.github.com"
	},
	"engines": {
		"node": ">=22"
	}
}
