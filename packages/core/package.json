{
	"name": "@ai-food-focus/feedbakkr-core",
	"version": "0.2.0",
	"description": "FeedBakkr form toolkit: schema format, validation, text format and exports.",
	"license": "UNLICENSED",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ai-food-focus/feedbakkr-core.git",
		"directory": "packages/core"
	},
	"type": "module",
	"sideEffects": false,
	"bin": {
		"feedbakkr": "./bin/feedbakkr.js"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./schema": {
			"types": "./dist/schema.d.ts",
			"import": "./dist/schema.js"
		},
		"./text": {
			"types": "./dist/text.d.ts",
			"import": "./dist/text.js"
		},
		"./export": {
			"types": "./dist/export.d.ts",
			"import": "./dist/export.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"bin",
		"dist",
		"docs",
		"README.md"
	],
	"publishConfig": {
		"registry": "https://npm.pkg.github.com"
	},
	"scripts": {
		"build": "tsup",
		"typecheck": "tsc --noEmit",
		"test": "vitest run && vitest run --config vitest.workers.config.ts",
		"check:package": "node scripts/check-boundaries.mjs && publint --strict && attw --pack . --profile esm-only"
	},
	"dependencies": {
		"zod": "^4.0.0"
	},
	"devDependencies": {
		"@arethetypeswrong/cli": "^0.18.5",
		"@cloudflare/vitest-plugin": "^1.4.0",
		"@modelcontextprotocol/sdk": "^1.32.1",
		"@types/node": "^22.0.0",
		"publint": "^0.3.25",
		"tsup": "^8.5.1",
		"typescript": "~6.0.3",
		"vitest": "^4.1.11"
	},
	"engines": {
		"node": ">=22"
	}
}
