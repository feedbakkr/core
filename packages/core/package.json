{
	"name": "@ai-food-focus/feedbakkr-core",
	"version": "0.6.0",
	"description": "FeedBakkr form toolkit: schema format, validation, submissions and messages, text format, exports, a React form and hook, and the form builder.",
	"license": "UNLICENSED",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ai-food-focus/feedbakkr-core.git",
		"directory": "packages/core"
	},
	"type": "module",
	"sideEffects": [
		"*.css"
	],
	"bin": {
		"feedbakkr": "./bin/feedbakkr.js"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./schema": {
			"types": "./dist/schema.d.ts",
			"import": "./dist/schema.js"
		},
		"./text": {
			"types": "./dist/text.d.ts",
			"import": "./dist/text.js"
		},
		"./export": {
			"types": "./dist/export.d.ts",
			"import": "./dist/export.js"
		},
		"./submissions": {
			"types": "./dist/submissions.d.ts",
			"import": "./dist/submissions.js"
		},
		"./messages": {
			"types": "./dist/messages.d.ts",
			"import": "./dist/messages.js"
		},
		"./conditions": {
			"types": "./dist/conditions.d.ts",
			"import": "./dist/conditions.js"
		},
		"./form": {
			"types": "./dist/form.d.ts",
			"import": "./dist/form.js"
		},
		"./react": {
			"types": "./dist/react.d.ts",
			"import": "./dist/react.js"
		},
		"./builder": {
			"types": "./dist/builder.d.ts",
			"import": "./dist/builder.js"
		},
		"./builder.css": "./dist/builder.css",
		"./package.json": "./package.json"
	},
	"files": [
		"bin",
		"dist",
		"docs",
		"README.md"
	],
	"publishConfig": {
		"registry": "https://npm.pkg.github.com"
	},
	"scripts": {
		"build": "tsup && node scripts/build-builder-css.mjs",
		"typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.react.json",
		"test": "vitest run && vitest run --config vitest.workers.config.ts",
		"check:package": "node scripts/check-boundaries.mjs && publint --strict && attw --pack . --profile esm-only --exclude-entrypoints ./builder.css",
		"test:e2e": "playwright test"
	},
	"dependencies": {
		"zod": "^4.0.0"
	},
	"peerDependencies": {
		"@dnd-kit/core": "^6.3.1",
		"@dnd-kit/sortable": "^10.0.0",
		"@dnd-kit/utilities": "^3.2.2",
		"lucide-react": ">=0.577.0 <1",
		"radix-ui": "^1.4.3",
		"react": "^19.0.0",
		"react-dom": "^19.0.0"
	},
	"peerDependenciesMeta": {
		"@dnd-kit/core": {
			"optional": true
		},
		"@dnd-kit/sortable": {
			"optional": true
		},
		"@dnd-kit/utilities": {
			"optional": true
		},
		"lucide-react": {
			"optional": true
		},
		"radix-ui": {
			"optional": true
		},
		"react": {
			"optional": true
		},
		"react-dom": {
			"optional": true
		}
	},
	"devDependencies": {
		"@arethetypeswrong/cli": "^0.18.5",
		"@cloudflare/vitest-plugin": "^1.4.0",
		"@dnd-kit/core": "^6.3.1",
		"@dnd-kit/sortable": "^10.0.0",
		"@dnd-kit/utilities": "^3.2.2",
		"@modelcontextprotocol/sdk": "^1.32.1",
		"@playwright/test": "^1.64.0",
		"@tailwindcss/postcss": "^4.3.3",
		"@testing-library/dom": "^10.4.2",
		"@testing-library/react": "^16.3.3",
		"@types/node": "^22.0.0",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.2",
		"ajv": "^8.20.0",
		"ajv-formats": "^3.0.1",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"jsdom": "^30.1.2",
		"lucide-react": "^0.577.0",
		"postcss": "^8.5.29",
		"publint": "^0.3.25",
		"radix-ui": "^1.8.0",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"tailwind-merge": "^3.7.0",
		"tailwindcss": "^4.3.3",
		"tsup": "^8.5.1",
		"tw-animate-css": "^1.4.0",
		"typescript": "~6.0.3",
		"vite": "^8.3.4",
		"vitest": "^4.1.11"
	},
	"engines": {
		"node": ">=22"
	}
}
