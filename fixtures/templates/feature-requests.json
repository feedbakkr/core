[
	{
		"title": "Simple Feature Request",
		"templateKey": "simple-feature-request",
		"description": "Collect feature ideas from users with a clear title, problem statement, and expected benefit.",
		"tags": ["features", "product", "ideas"],
		"schema": {
			"v": 1,
			"fields": [
				{
					"k": "title",
					"label": "Feature Title",
					"t": "text",
					"req": true,
					"min": 3,
					"max": 200
				},
				{
					"k": "priority",
					"label": "Priority",
					"t": "fixed",
					"opts": [
						{
							"k": "nice_to_have",
							"label": "Nice to Have"
						},
						{
							"k": "important",
							"label": "Important"
						},
						{
							"k": "critical",
							"label": "Critical"
						}
					]
				},
				{
					"k": "problem",
					"label": "What problem are you trying to solve?",
					"t": "textarea",
					"req": true,
					"min": 20,
					"max": 2000
				},
				{
					"k": "suggestion",
					"label": "What would you like to see?",
					"t": "textarea",
					"req": true,
					"min": 20,
					"max": 2000
				},
				{
					"k": "expectedBenefit",
					"label": "Expected Benefit",
					"t": "textarea",
					"max": 1500
				}
			],
			"preview": {
				"mode": "custom",
				"fields": ["title", "priority"],
				"separator": " · ",
				"maxLength": 100
			}
		}
	},
	{
