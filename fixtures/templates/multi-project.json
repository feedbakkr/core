[
	{
		"title": "Generic Product Feedback",
		"templateKey": "generic-product-feedback",
		"description": "A reusable feedback form suitable across multiple apps or websites in a shared Feedbakkr workspace.",
		"tags": ["feedback", "product", "general"],
		"schema": {
			"v": 1,
			"fields": [
				{
					"k": "feedbackType",
					"label": "Feedback Type",
					"t": "fixed",
					"req": true,
					"opts": [
						{
							"k": "idea",
							"label": "Idea"
						},
						{
							"k": "issue",
							"label": "Issue"
						},
						{
							"k": "question",
							"label": "Question"
						},
						{
							"k": "praise",
							"label": "Praise"
						},
						{
							"k": "other",
							"label": "Other"
						}
					]
				},
				{
					"k": "title",
					"label": "Title",
					"t": "text",
					"req": true,
					"min": 3,
					"max": 200
				},
				{
					"k": "message",
					"label": "Message",
					"t": "textarea",
					"req": true,
					"min": 10,
					"max": 2000
				},
				{
					"k": "email",
					"label": "Email Address",
					"t": "text",
					"max": 200
				}
			],
			"preview": {
				"mode": "custom",
				"fields": ["feedbackType", "title"],
				"separator": " · ",
				"maxLength": 100
			}
		}
	},
	{
