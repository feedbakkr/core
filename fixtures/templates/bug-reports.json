[
	{
		"title": "Public Bug Report",
		"templateKey": "public-bug-report",
		"description": "A user-friendly bug report form for customer-facing apps that captures the essentials without being too technical.",
		"tags": ["bugs", "support", "users"],
		"schema": {
			"v": 1,
			"fields": [
				{
					"k": "fullName",
					"label": "Your Name",
					"t": "text",
					"max": 100
				},
				{
					"k": "email",
					"label": "Email Address",
					"t": "text",
					"max": 200
				},
				{
					"k": "bugTitle",
					"label": "Issue Title",
					"t": "text",
					"req": true,
					"min": 3,
					"max": 200
				},
				{
					"k": "category",
					"label": "Category",
					"t": "fixed",
					"req": true,
					"opts": [
						{
							"k": "ui",
							"label": "UI / Layout"
						},
						{
							"k": "login",
							"label": "Login / Access"
						},
						{
							"k": "performance",
							"label": "Performance"
						},
						{
							"k": "data",
							"label": "Data / Content"
						},
						{
							"k": "billing",
							"label": "Billing"
						},
						{
							"k": "other",
							"label": "Other"
						}
					]
				},
				{
					"k": "severity",
					"label": "How serious is it?",
					"t": "fixed",
					"req": true,
					"opts": [
						{
							"k": "low",
							"label": "Low"
						},
						{
							"k": "medium",
							"label": "Medium"
						},
						{
							"k": "high",
							"label": "High"
						}
					]
				},
				{
					"k": "whatHappened",
					"label": "What happened?",
					"t": "textarea",
					"req": true,
					"min": 20,
					"max": 2000
				},
				{
					"k": "stepsToReproduce",
					"label": "Steps to Reproduce",
					"t": "dynlist",
					"maxItems": 8,
					"item": {
						"k": "step",
						"label": "Step",
						"t": "text",
						"max": 500
					}
				},
				{
					"k": "pageUrl",
					"label": "Page URL",
					"t": "text",
					"max": 500
				}
			],
			"preview": {
				"mode": "custom",
				"fields": ["bugTitle", "severity"],
				"separator": " · ",
				"maxLength": 100
			}
		}
	},
