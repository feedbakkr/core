					"req": true,
					"opts": [
						{
							"k": "issue",
							"label": "Issue"
						},
						{
							"k": "suggestion",
							"label": "Suggestion"
						},
						{
							"k": "question",
							"label": "Question"
						},
						{
							"k": "praise",
							"label": "Praise"
						}
					]
				},
				{
					"k": "pageContext",
					"label": "Page or Context",
					"t": "text",
					"max": 300
				},
				{
					"k": "message",
