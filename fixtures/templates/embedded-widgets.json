	},
	{
		"title": "Exit Intent Feedback",
		"templateKey": "exit-intent-feedback",
		"description": "Ask users why they are leaving or abandoning a journey so teams can identify friction, confusion, or missing value.",
		"tags": ["widget", "conversion", "ux"],
		"schema": {
			"v": 1,
			"fields": [
				{
					"k": "reasonForLeaving",
					"label": "Why are you leaving?",
					"t": "fixed",
					"req": true,
					"opts": [
						{
							"k": "just_browsing",
							"label": "Just Browsing"
						},
						{
							"k": "too_expensive",
							"label": "Too Expensive"
						},
						{
							"k": "not_ready",
							"label": "Not Ready Yet"
						},
						{
							"k": "missing_feature",
							"label": "Missing Feature"
						},
						{
							"k": "confusing",
							"label": "Confusing Experience"
						},
						{
							"k": "technical_issue",
							"label": "Technical Issue"
						},
						{
							"k": "other",
							"label": "Other"
						}
					]
				},
				{
					"k": "whatStoppedYou",
					"label": "What stopped you today?",
					"t": "textarea",
					"max": 1500
				},
				{
					"k": "wouldLikeFollowUp",
					"label": "I'd like someone to follow up",
					"t": "bool"
				},
				{
					"k": "email",
					"label": "Email Address",
					"t": "text",
					"max": 200
				}
			],
			"preview": {
				"mode": "custom",
				"fields": ["reasonForLeaving", "email"],
				"separator": " · ",
				"fallbackFields": ["whatStoppedYou"],
				"maxLength": 100
			}
		}
	},
