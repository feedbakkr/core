[
	{
		"title": "Quick Feedback Widget",
		"templateKey": "quick-feedback-widget",
		"description": "A tiny embedded widget for collecting fast user feedback from any page with almost no friction.",
		"tags": ["widget", "feedback", "ux"],
		"schema": {
			"v": 1,
			"fields": [
				{
					"k": "sentiment",
					"label": "How was your experience?",
					"t": "fixed",
					"req": true,
					"opts": [
						{
							"k": "great",
							"label": "Great"
						},
						{
							"k": "okay",
							"label": "Okay"
						},
						{
							"k": "poor",
							"label": "Poor"
						}
					]
				},
				{
					"k": "comment",
					"label": "Comment",
					"t": "textarea",
					"max": 1000
				}
			],
			"preview": {
				"mode": "custom",
				"fields": ["sentiment", "comment"],
				"separator": " · ",
				"maxLength": 100,
				"fallbackFields": ["sentiment"]
			}
		}
	},
	{
