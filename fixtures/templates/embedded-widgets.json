	{
		"title": "Page Feedback Widget",
		"templateKey": "page-feedback-widget",
		"description": "Capture feedback tied to a specific page or context within the app so teams can understand issues and suggestions in the right place.",
		"tags": ["widget", "page", "feedback"],
		"schema": {
			"v": 1,
			"fields": [
				{
					"k": "feedbackType",
					"label": "Feedback Type",
