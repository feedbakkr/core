				{ "k": "companyName", "label": "Company Name", "t": "text", "max": 150 },
				{
					"k": "enquiryType",
					"label": "Enquiry Type",
					"t": "fixed",
					"req": true,
					"opts": [
						{ "k": "general", "label": "General Question" },
						{ "k": "sales", "label": "Sales" },
						{ "k": "support", "label": "Support" },
						{ "k": "partnership", "label": "Partnership" },
						{ "k": "other", "label": "Other" }
