	{
		"title": "General Business Contact",
		"templateKey": "general-business-contact",
		"description": "A flexible contact form for company websites that captures general enquiries, the reason for contact, and enough detail for the team to respond appropriately.",
		"tags": ["business", "contact", "general"],
		"schema": {
			"v": 1,
