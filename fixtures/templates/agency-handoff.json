[
	{
		"title": "Website Launch Feedback",
		"templateKey": "website-launch-feedback",
		"description": "Help agencies collect structured post-launch feedback from clients, including issues, polish items, and follow-up requests.",
		"tags": ["agency", "launch", "client"],
		"schema": {
			"v": 1,
			"fields": [
				{
					"k": "clientName",
					"label": "Client Name",
					"t": "text",
					"req": true,
					"min": 2,
					"max": 100
				},
				{
					"k": "pageOrArea",
					"label": "Page or Area",
					"t": "text",
					"max": 200
				},
				{
					"k": "feedbackType",
					"label": "Feedback Type",
					"t": "fixed",
					"req": true,
					"opts": [
						{
							"k": "bug",
							"label": "Bug / Issue"
						},
						{
							"k": "content_change",
							"label": "Content Change"
						},
						{
							"k": "design_tweak",
							"label": "Design Tweak"
						},
						{
							"k": "enhancement",
							"label": "Enhancement"
						},
						{
							"k": "question",
							"label": "Question"
						}
					]
				},
				{
					"k": "priority",
					"label": "Priority",
					"t": "fixed",
					"opts": [
						{
							"k": "low",
							"label": "Low"
						},
						{
							"k": "medium",
							"label": "Medium"
						},
						{
							"k": "high",
							"label": "High"
						}
					]
				},
				{
					"k": "details",
					"label": "Details",
					"t": "textarea",
					"req": true,
					"min": 20,
					"max": 2000
				},
				{
					"k": "launchBlocker",
					"label": "Is this a launch blocker?",
					"t": "bool"
				}
			],
			"preview": {
				"mode": "custom",
				"fields": ["feedbackType", "pageOrArea"],
				"separator": " · ",
				"fallbackFields": ["clientName"],
				"maxLength": 100
			}
		}
	},
