					"k": "meetingName",
					"label": "Meeting or workshop name",
					"t": "text",
					"req": true,
					"max": 200
				},
				{
					"k": "usefulness",
					"label": "How useful was this session?",
					"t": "fixed",
					"req": true,
					"opts": [
						{ "k": "very_useful", "label": "Very useful" },
						{ "k": "somewhat_useful", "label": "Somewhat useful" },
						{ "k": "not_useful", "label": "Not useful" },
						{ "k": "waste_of_time", "label": "Could have been an email" }
					]
				},
				{
					"k": "bestPart",
					"label": "What was the most valuable part?",
					"t": "textarea",
					"max": 1000
				},
				{
					"k": "improvement",
					"label": "What could be improved?",
					"t": "textarea",
					"max": 1000
				},
				{
					"k": "actionClarity",
					"label": "Were action items clear?",
					"t": "fixed",
					"opts": [
						{ "k": "yes", "label": "Yes" },
						{ "k": "somewhat", "label": "Somewhat" },
						{ "k": "no", "label": "No" }
					]
				}
			],
			"preview": {
				"mode": "custom",
				"fields": ["meetingName", "usefulness"],
				"separator": " · ",
				"maxLength": 100,
				"fallbackFields": ["meetingName"]
			}
		}
	}
]
